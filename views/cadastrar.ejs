<%- include('partials/header') %>
<div class="bg-white p-4 rounded-3 shadow-sm border max-width-600 mx-auto">
    <h3 class="text-dark border-bottom pb-2 fw-bold mb-3 fs-5">Nova Tecnologia</h3>
    <form action="/admin/cadastrar" method="POST">
        <div class="mb-3"><label class="form-label text-secondary small">Nome da Ferramenta</label><input type="text" name="nome" class="form-control" required></div>
        <div class="mb-3"><label class="form-label text-secondary small">Descrição Técnica</label><textarea name="descricao" class="form-control" rows="4" required></textarea></div>
        <div class="d-flex gap-2">
            <button class="btn btn-success flex-grow-1" type="submit">Salvar no Banco</button>
            <a href="/admin" class="btn btn-outline-secondary flex-grow-1">Cancelar</a>
        </div>
    </form>
</div>
<%- include('partials/footer') %>
