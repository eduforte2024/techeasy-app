    <script>
        function navegar(idSecao) {
            // Oculta todas as seções
            const secoes = document.querySelectorAll('.secao-teste');
            secoes.forEach(secao => secao.classList.remove('secao-ativa'));
            
            // Mostra a seção desejada
            const alvo = document.getElementById(idSecao);
            if (alvo) {
                alvo.classList.add('secao-ativa');
            }

            // CORREÇÃO PARA CELULAR: Fecha o menu hambúrguer automaticamente após clicar em um link
            const menuNavbar = document.getElementById('navbarNav');
            if (menuNavbar.classList.contains('show')) {
                const bootstrapMenu = bootstrap.Collapse.getInstance(menuNavbar);
                if (bootstrapMenu) {
                    bootstrapMenu.hide();
                } else {
                    menuNavbar.classList.remove('show');
                }
            }

            window.scrollTo(0, 0);
        }

        function gerarRecomendacao(event) {
            event.preventDefault();
            const tipo = document.getElementById('tipo').value;
            const usuarios = document.getElementById('usuarios').value;
            const orcamento = document.getElementById('orcamento').value;

            let front = "HTML5 + CSS3 + Bootstrap 5";
            let back = "Node.js + Express";
            let banco = "SQLite (Local)";
            let nuvem = "Render (Plano Gratuito)";

            if (tipo === 'institucional') {
                front = "HTML5 + Tailwind CSS";
                back = "Não aplicável (Site Estático)";
                banco = "Não aplicável";
                nuvem = "Vercel (Plano Free)";
            } else if (tipo === 'ecommerce') {
                front = "React.js + Bootstrap";
                back = "Node.js (API REST)";
                banco = "PostgreSQL (Robusto)";
                nuvem = "Render Cloud";
            } else if (tipo === 'mobile') {
                front = "Framework Flutter (Dart)";
                back = "Node.js / Firebase";
                banco = "MongoDB (NoSQL)";
                nuvem = "Google Cloud Platform";
            }

            if (usuarios === 'alto' || orcamento === 'corporativo') {
                if(banco === 'SQLite (Local)') banco = "PostgreSQL Cluster";
                nuvem = "Amazon Web Services (AWS Cloud Elástica)";
            }

            document.getElementById('conteudoDiagnostico').innerHTML = `
                <p><strong>Projeto:</strong> <span class="text-capitalize">${tipo}</span></p>
                <div class="p-3 bg-white border rounded mb-2">
                    <p class="m-1"><strong>🎨 Front-End:</strong> ${front}</p>
                    <p class="m-1"><strong>⚙️ Back-End:</strong> ${back}</p>
                    <p class="m-1"><strong>🗄️ Banco de Dados:</strong> ${banco}</p>
                    <p class="m-1"><strong>☁️ Hospedagem:</strong> ${nuvem}</p>
                </div>
            `;
            document.getElementById('formAssistente').classList.add('d-none');
            document.getElementById('resultadoConsultoria').classList.remove('d-none');
        }

        function reiniciarAssistente() {
            document.getElementById('formAssistente').reset();
            document.getElementById('formAssistente').classList.remove('d-none');
            document.getElementById('resultadoConsultoria').classList.add('d-none');
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
